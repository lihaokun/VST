opam-version: "2.0"
name: "coq-vst"
version: "2.16+fusion"
synopsis: "VST with optional exact stores and reusable integer views"
maintainer: "CCV toolchain maintainers"
authors: ["VST team" "CCV fusion contributors"]
license: "BSD-2-Clause"
homepage: "https://github.com/lihaokun/VST"
bug-reports: "https://github.com/lihaokun/VST/issues"
dev-repo: "git+https://github.com/lihaokun/VST.git"
depends: [
  "ocaml" {= "4.14.2"}
  "coq" {= "9.0.0"}
  "coq-core" {= "9.0.0"}
  "coq-stdlib" {= "9.0.0"}
  "coq-compcert" {= "3.17"}
  "coq-flocq" {= "4.2.2"}
  "coq-vst-zlist" {= "2.13"}
]
build: [
  [make "-j%{jobs}%" "vst" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=platform" "ZLIST=platform" "BITSIZE=64"]
]
install: [
  [make "install" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=platform" "ZLIST=platform" "BITSIZE=64"]
]
run-test: [
  [make "-j%{jobs}%" "test-fusion" "COMPCERT=platform" "ZLIST=platform" "BITSIZE=64"]
]
