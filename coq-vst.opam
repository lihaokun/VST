opam-version: "2.0"
name: "coq-vst"
version: "2.16-fmv1"
synopsis: "VST with optional exact stores and reusable integer views"
maintainer: "CCV toolchain maintainers"
authors: ["VST team" "CCV fusion contributors"]
license: "BSD-2-Clause"
homepage: "https://github.com/lihaokun/VST"
bug-reports: "https://github.com/lihaokun/VST/issues"
dev-repo: "git+https://github.com/lihaokun/VST.git"
depends: [
  "ocaml" {= "4.14.2"}
  "coq" {= "9.0.0"}
  "coq-core" {= "9.0.0"}
  "coq-stdlib" {= "9.0.0"}
  "conf-python-3"
  "coq-vst-zlist" {= "2.13"}
]
build: [
  [make "-j%{jobs}%" "vst" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=semantics" "ZLIST=platform" "BITSIZE=64"]
]
install: [
  [make "install" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=semantics" "ZLIST=platform" "BITSIZE=64"]
]
run-test: [
  [make "-j%{jobs}%" "test-fusion" "COMPCERT=semantics" "ZLIST=platform" "BITSIZE=64"]
]
description: """
This fork consumes a separately exported ClightForge semantics component.
Export SEMANTICS_DIR=/absolute/component before invoking opam (including install).
The component supplies both compcert and Flocq; it is not an official CompCert
package. See BUILD_ORGANIZATION.md for export and verification commands.
"""
