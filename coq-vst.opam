opam-version: "2.0"
name: "coq-vst"
version: "2.16-fmv1"
synopsis: "VST with optional exact stores and reusable integer views"
maintainer: "CCV toolchain maintainers"
authors: ["VST team" "CCV fusion contributors"]
license: "BSD-2-Clause"
homepage: "https://github.com/lihaokun/VST"
bug-reports: "https://github.com/lihaokun/VST/issues"
dev-repo: "git+https://github.com/lihaokun/VST.git"
depends: [
  "ocaml" {= "4.14.2"}
  "coq-core" {= "9.0.0"}
  "rocq-stdlib" {= "9.0.0"}
  "conf-python-3"
  "clightforge" {= "0.1.0+pkg3"}
]
conflicts: ["coq-vst-zlist" "coq-compcert" "coq-flocq"]
build-env: [
  [SEMANTICS_DIR = "%{lib}%/coq/user-contrib"]
  [SEMANTICS_MANIFEST = "%{share}%/clightforge/semantics.json"]
]
build: [
  [make "-j%{jobs}%" "vst" "progs64" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=semantics" "ZLIST=bundled" "BITSIZE=64"]
]
install: [
  [make "install" "INSTALLDIR=%{lib}%/coq/user-contrib/VST" "COQBIN=%{bin}%/" "COMPCERT=semantics" "ZLIST=bundled" "BITSIZE=64"]
]
run-test: [
  [make "-j%{jobs}%" "test-fusion" "COMPCERT=semantics" "ZLIST=bundled" "BITSIZE=64"]
]
description: """
This fork consumes the switch-installed ClightForge libraries and manifest.
The package builds its own zlist and needs no external semantics export.
"""
